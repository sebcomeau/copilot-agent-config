# Ignore everything by default.
*

# Keep this ignore file itself.
!.gitignore

# Keep the root files.
!AGENTS.md
!CONTRIBUTING.md
!README.md
!SUBAGENT_ROUTING.md

# Keep the agents directory and all agent markdown files.
!agents/
!agents/*.agent.md

# Keep repository-owned Agent Skills.
!skills/
!skills/*/
!skills/*/SKILL.md
