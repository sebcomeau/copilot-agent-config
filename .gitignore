# Ignore everything by default.
*

# Keep this ignore file itself.
!.gitignore

# Keep the root files.
!AGENTS.md
!CONTRIBUTING.md
!README.md

# Allow Git to look inside the agents and skills directories.
!agents/
!skills/

# Keep agent and skill source files.
!agents/**
!skills/**

# Ignore generated skill evaluation workspaces.
skills/*-workspace/