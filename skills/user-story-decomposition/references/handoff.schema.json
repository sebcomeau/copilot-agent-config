{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://copilot.local/schemas/user-story-decomposition-handoff.json",
  "title": "User Story Decomposition Publishing Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "revision",
    "approval",
    "tracker",
    "metadata",
    "tasks",
    "relations",
    "blockers"
  ],
  "properties": {
    "version": { "const": 1 },
    "revision": { "type": "string", "pattern": "^R[1-9][0-9]*$" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "publishRequested", "evidence"],
      "properties": {
        "approved": { "const": true },
        "publishRequested": { "const": true },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "project", "team", "targetStoryId"],
      "properties": {
        "organization": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "team": { "type": "string", "minLength": 1 },
        "targetStoryId": { "type": "integer", "minimum": 1 }
      }
    },
    "transportPolicy": { "enum": ["auto", "mcp", "cli"] },
    "metadata": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action"],
        "properties": {
          "action": {
            "enum": ["inherit", "explicit", "tracker-default", "omit"]
          },
          "value": {}
        },
        "allOf": [
          {
            "if": { "properties": { "action": { "const": "explicit" } } },
            "then": { "required": ["value"] }
          }
        ]
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "descriptionMarkdown", "dependsOn"],
        "properties": {
          "key": { "type": "string", "pattern": "^T[1-9][0-9]*$" },
          "title": { "type": "string", "minLength": 1 },
          "descriptionMarkdown": { "type": "string", "minLength": 1 },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string", "pattern": "^T[1-9][0-9]*$" }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "from", "to"],
        "properties": {
          "type": { "enum": ["parent", "predecessor"] },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 }
        }
      }
    },
    "externalDependencies": { "type": "array", "items": { "type": "string" } },
    "blockers": { "const": "none" }
  }
}
